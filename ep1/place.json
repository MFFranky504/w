[[0.2, 1.12, "Diez países."], [1.7, 2.77, "Una cabaña helada."], [3.3, 4.21, "Una sola chispa."], [4.9, 5.68, "¿Tú qué harías?"], [6.7, 8.49, "Nadie sabe por qué están aquí."], [9.2, 9.67, "Yo sí."], [10.6, 11.92, "Una decisión por país."], [12.9, 13.95, "Ustedes deciden."], [15.6, 17.07, "Cien de resistencia."], [18.4, 19.75, "Cero... eliminado."], [21.6, 24.69, "La cabaña se congela: tres grados menos cada hora."], [27.5, 28.14, "Un hacha."], [28.6, 29.43, "Un encendedor."], [31.7, 32.38, "Un cuchillo."], [32.8, 33.32, "Un mapa."], [35.3, 36.25, "Cinco velas."], [36.4, 37.21, "Troncos húmedos."], [37.4, 38.5, "Tres leños secos."], [38.9, 39.67, "Y una nota."], [40.0, 41.09, "Léanla con cuidado."], [41.3, 43.18, "El frío no se vence con fuerza."], [44.0, 45.71, "Lo que pesa, no te salvará."], [45.79, 50.0, "Lo que brilla poco, gástalo una sola vez, y donde más dure."], [50.7, 51.94, "El humo conoce la salida."], [53.5, 54.24, "Tres caminos."], [54.8, 57.36, "A: la chimenea, con los leños secos."], [58.6, 61.02, "B: el muro, con el hacha."], [62.1, 63.58, "C: las cinco velas."], [64.55, 67.01, "Escriban país y letra en los comentarios."], [67.55, 68.59, "Veinticuatro horas."], [69.55, 71.89, "Después... no habrá marcha atrás."], [72.0, 73.14, "¿Qué país caerá primero?"]]
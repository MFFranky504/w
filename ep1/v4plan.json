[["v3/n00.mp3", 0.2, "Diez pa\u00edses."], ["v3/n01.mp3", 1.7, "Una caba\u00f1a helada."], ["v3/n02.mp3", 3.3, "Una sola chispa."], ["v3/n03.mp3", 4.9, "\u00bfT\u00fa qu\u00e9 har\u00edas?"], ["v2/n02.mp3", 6.7, "Nadie sabe por qu\u00e9 est\u00e1n aqu\u00ed."], ["v2/n03.mp3", 9.2, "Yo s\u00ed."], ["v3/n06.mp3", 10.6, "Una decisi\u00f3n por pa\u00eds."], ["v3/n07.mp3", 12.9, "Ustedes deciden."], ["v2/n11.mp3", 15.6, "Cien de resistencia."], ["v3/n09.mp3", 18.4, "Cero... eliminado."], ["v3/n10.mp3", 21.6, "La caba\u00f1a se congela: tres grados menos cada hora."], ["v2/n17.mp3", 27.5, "Un hacha."], ["v3/n12.mp3", 28.6, "Un encendedor."], ["v2/n19.mp3", 31.7, "Un cuchillo."], ["v2/n20.mp3", 32.8, "Un mapa."], ["v2/n21.mp3", 35.3, "Cinco velas."], ["v2/n22.mp3", 36.4, "Troncos h\u00famedos."], ["v2/n23.mp3", 37.4, "Tres le\u00f1os secos."], ["v2/n24.mp3", 38.9, "Y una nota."], ["v2/n25.mp3", 40.0, "L\u00e9anla con cuidado."], ["v2/n26.mp3", 41.3, "El fr\u00edo no se vence con fuerza."], ["v2/n27.mp3", 44.0, "Lo que pesa, no te salvar\u00e1."], ["v2/n28.mp3", 45.7, "Lo que brilla poco, g\u00e1stalo una sola vez, y donde m\u00e1s dure."], ["v2/n29.mp3", 50.7, "El humo conoce la salida."], ["v2/n30.mp3", 53.5, "Tres caminos."], ["v3/n25.mp3", 54.8, "A: la chimenea, con los le\u00f1os secos."], ["v3/n26.mp3", 58.6, "B: el muro, con el hacha."], ["v3/n27.mp3", 62.1, "C: las cinco velas."], ["v2/n35.mp3", 64.55, "Escriban pa\u00eds y letra en los comentarios."], ["v2/n36.mp3", 67.55, "Veinticuatro horas."], ["v2/n37.mp3", 69.55, "Despu\u00e9s... no habr\u00e1 marcha atr\u00e1s."], ["v3/n31.mp3", 72.0, "\u00bfQu\u00e9 pa\u00eds caer\u00e1 primero?"]]
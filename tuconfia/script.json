   "tag": ""
  },
  {
   "id": "L3c",
   "t": "Su esposa trabajaba en una cafetería de donas.",
   "p": 0.3,
   "tag": ""
  },
  {
   "id": "L4a",
   "t": "Escribe tres páginas.",

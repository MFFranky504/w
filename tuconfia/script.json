  },
  {
   "id": "L4c",
   "t": "Las arruga... y *las tira*.",
   "p": 0.7,
   "tag": "[seco]"
  },
  {
   "id": "L5",
   "t": "Al día siguiente, *Tabitha* las encuentra en la basura.",
   "p": 0.3,
   "tag": "[intenso]"
  },
  {
   "id": "L6",
   "t": "¿Y sabes qué le dijo?",
   "p": 0.5,
   "tag": "[susurrando, misterio]"
  },
  {
   "id": "L7",
   "t": "Que ahí *había algo*. Que *no se rindiera*.",
   "p": 0.35,
   "tag": "[cálido]"
  },
  {
   "id": "L8a",
   "t": "Terminó *Carrie*.",
   "p": 0.12,
   "tag": "[emocionado]"
  },
  {
   "id": "L8b",
   "t": "Anticipo: *dos mil quinientos dólares*.",
